# ─── Домен ──────────────────────────────────────────────────────────────
# Главный домен (canonical, sitemap, OG, IndexNow). нппбиохиммаш.рф в punycode
NEXT_PUBLIC_SITE_URL=https://xn--80abvauackga3exb.xn--p1ai

# ─── База данных ────────────────────────────────────────────────────────
# PostgreSQL на сервере. Если не задано — локально используется встроенный PGlite в ./.data/pglite
DATABASE_URL=postgres://biohimmash:CHANGE_ME@127.0.0.1:5432/biohimmash
# Необязательно: другой каталог для PGlite
# PGLITE_DIR=./.data/pglite

# ─── Медиа ──────────────────────────────────────────────────────────────
# Папка для загрузок вне репозитория; на сервере её отдаёт nginx по /media/
MEDIA_DIR=/var/www/biohimmash/media

# ─── Админка ────────────────────────────────────────────────────────────
ADMIN_LOGIN=admin
# Хэш argon2: npm run admin:hash -- 'пароль' — скрипт выводит готовую строку.
# Каждый `$` экранируется как `\$`, иначе Next раскроет его как переменную
ADMIN_PASSWORD_HASH=\$argon2id\$v=19\$m=19456,t=2,p=1\$...
# Секрет подписи сессии, минимум 32 символа: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS

# ─── Поисковики ─────────────────────────────────────────────────────────
# Ключ IndexNow (8–128 символов: a-z, A-Z, 0-9, -). Отдаётся по /indexnow-key.txt
INDEXNOW_KEY=
# Коды подтверждения (только значение content из meta-тега)
YANDEX_VERIFICATION=
GOOGLE_SITE_VERIFICATION=
